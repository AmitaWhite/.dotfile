# theme = Gruvbox Dark
# OS 라이트/다크를 따라감. nvim 은 이 배경색을 감지해 tokyonight day/night 를 자동 선택한다 (nvim README 참고)
theme = light:TokyoNight Day,dark:TokyoNight Moon
macos-titlebar-style = tabs
background-opacity = 0.85
background-blur=true

# 커서를 그 밑 글자 색의 반전으로 그린다 (helix 의 ui.cursor = reversed 와 같은 모양).
# nvim 의 Cursor 그룹은 고정 흰색이라 터미널 쪽에서 맞추는 게 확실하다.
cursor-invert-fg-bg = true

# keybind
keybind = global:opt+space=toggle_quick_terminal
